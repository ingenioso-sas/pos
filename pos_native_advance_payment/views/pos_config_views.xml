<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_inherit_advance_suggest" model="ir.ui.view">
        <field name="name">pos.config.view.form.inherit.advance.suggest</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='accounting_section']" position="after">
                <h2>Saldos a Favor</h2>
                <div class="row mt16 o_settings_container" id="advance_suggest_section">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="pos_advance_suggest"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="pos_advance_suggest"/>
                            <div class="text-muted">
                                Al abrir la pantalla de pago con un cliente que
                                tiene saldo disponible, muestra una alerta única
                                por pedido para ofrecer pagar con saldo a favor.
                            </div>
                            <div class="content-group mt16" attrs="{'invisible': [('pos_advance_suggest', '=', False)]}">
                                <div class="row mt16">
                                    <label string="Monto Sugerido" for="pos_advance_suggest_mode" class="col-lg-3 o_light_label"/>
                                    <field name="pos_advance_suggest_mode"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
